# Bu repoya özgü yayın ayarları. ops/ script'leri proje adından bağımsızdır; sadece bu dosya değişir.
NAME=titanlar                                   # → /opt/titanlar, titanlar-update.timer, titanlar-npm-cache
REPO=atonota/titanlar                           # GitHub repo (CI kapısı ve kaynak)
CHECK_NAME=build                                # GitHub Actions job adı (success olmalı)
DEFAULT_DOMAINS="titanlar.com www.titanlar.com" # argümansız ilk kurulumda; www.* → ana alan adına yönlendirme
